@using E_Commers_Adelia.Common
@using Microsoft.AspNetCore.Identity
@model IEnumerable<E_Commers_Adelia.Models.Order>
@inject ApplicationDbContext db
@inject UserManager<EUser> userManager
@{
    ViewData["Title"] = "View Order";
}
<div class="page-header">
    <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-action="Index" asp-controller="Home">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a asp-action="Index">Order Request</a>
        </li>
    </ul>
</div>
<div class="card shadow rounded-3 mb-4">
    
    @foreach (var order in Model)
    {
        var product = await db.Products.FindAsync(order.ProductId);
        var customer = await userManager.FindByIdAsync(order.CustomerId);
        var duration = DurationCalulator.GetTimeAgo(order.PlaceDateTime);

        <div class="card-header d-flex justify-content-between align-items-center bg-light border-0">
            <h5 class="card-title mb-0 text-primary"># @order.OrderNo</h5>
            <div class="card-tool">
                @duration
            </div>
        </div>
        <div class="card-body">
            <div class="row align-items-center">

                <!-- Product Image -->
                <div class="col-3 col-md-2 text-center">
                    <img src="@(string.IsNullOrEmpty(product.ImageUrl)
                                                ? Url.Content("~/img/blank.jpg")
                                                : Url.Content("~/" + product.ImageUrl))"
                         alt="..."
                         class="img-fluid fa-caret-square-up "
                         style="max-width: 60px;height:auto" />
                </div>

                <!-- Product Info -->
                <div class="col-6 col-md-5">
                    <div class="fw-bold">@product.Name</div>
                    @if (order.SelectedOption != null && order.SelectedOption.Any())
                    {
                        var options = order.SelectedOption.Split("\r\n");
                        <div class="fw-bold">Options:</div>
                        foreach (var option in options)
                        {
                            <div class="text-muted small">
                                <span class="text-dark text-wrap me-1 mb-1">
                                    @option
                                </span>
                            </div>
                        }
                    }
                </div>
                <!-- Product Info -->
                <div class="col-3 col-md-5 text-end">
                    <div class="card-tools" style="">
                        <div class="dropdown dropup">
                            <button class="btn btn-icon btn-clean me-0"
                                    type="button"
                                    id="dropdownMenuButton"
                                    data-bs-toggle="dropdown"
                                    aria-haspopup="true"
                                    aria-expanded="false">
                                <i class="fas fa-ellipsis-v"></i>
                            </button>
                            <div class="dropdown-menu"
                                 aria-labelledby="dropdownMenuButton">
                                <a class="dropdown-item" href="#">Accept</a>
                                <a class="dropdown-item" href="#">Reject</a>
                                <a class="dropdown-item" href="#">Comfirm Payment</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quantity & Price -->
                <div class="col-12 col-md-12 mt-2 mt-md-0">
                    <div class="col-12 col-md-2 mt-2 mt-md-0 text-end">
                    </div>
                    <div class="d-flex justify-content-between justify-content-md-end gap-md-3">
                        <span>Subtotal:</span>
                        <span>x @order.Quantity</span>
                        <span class="fw-bold">RM<span id="@($"totalPrice{order.Id}")">@order.SubTotalPrice</span></span>
                    </div>
                </div>
            </div>
            <hr />

        </div>
    }
    <div class="card-footer">
        <div class="d-flex justify-content-between justify-content-md-end gap-md-3">
            <h5 class="mb-0 fw-bold">
                Total (<span class="text-primary">@Model.Count()</span> item@((Model.Count() > 1) ? "s" : "")):
            </h5>
            <h3 class="mb-0 text-black fw-bold text-decoration-underline">
                @($"RM{Model.Select(x=>x.SubTotalPrice).Sum()}")
            </h3>
        </div>
    </div>
</div>