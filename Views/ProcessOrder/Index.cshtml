@using Microsoft.AspNetCore.Identity
@using E_Commers_Adelia.Common
@model IEnumerable<E_Commers_Adelia.Models.Order>
@inject UserManager<EUser> userManager
@inject ApplicationDbContext db
@{
    ViewData["Title"] = "Order Request";
}
<div class="page-header">
    <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-action="Index" asp-controller="Home">
                <i class="icon-home"></i>
            </a>
        </li>
    </ul>
</div>
<hr />

<div class="row">
    <div class="col-md-6">
        <ul class="nav nav-pills nav-secondary" id="pills-tab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="pills-neworder-tab" data-bs-toggle="pill" href="#pills-neworder" role="tab" aria-controls="pills-neworder" aria-selected="true">New Order</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="pills-Cancel-tab" data-bs-toggle="pill" href="#pills-Cancel" role="tab" aria-controls="pills-Cancel" aria-selected="false">Cancel</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="pills-complete-tab" data-bs-toggle="pill" href="#pills-complete" role="tab" aria-controls="pills-complete" aria-selected="false">Complete</a>
            </li>
        </ul>
        <div class="tab-content mt-2 mb-3" id="pills-tabContent">
            <div class="tab-pane fade show active" id="pills-neworder" role="tabpanel" aria-labelledby="pills-neworder-tab">
                <div class="card shadow rounded-3 mb-4">
                    <div class="list-group">
                        @foreach (var order in Model.Select(x => x.OrderNo).Distinct().ToList())
                        {
                            <a 
                                asp-action="View" 
                                asp-controller="ProcessOrder" 
                                asp-route-id="@order" 
                                class="list-group-item list-group-item-action @(Model.FirstOrDefault(x=> x.OrderNo == order).StatusId < 3 ? "active":"") ">
                                <div class="d-flex justify-content-between align-items-center px-3">
                                    <div><i class="fa fa-shopping-bag"></i>  @order</div>
                                </div>
                            </a>
                    }
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="pills-Cancel" role="tabpanel" aria-labelledby="pills-Cancel-tab">
            </div>
            <div class="tab-pane fade" id="pills-complete" role="tabpanel" aria-labelledby="pills-complete-tab">
            </div>
        </div>
    </div>
</div>
