@using Microsoft.AspNetCore.Identity
@using E_Commers_Adelia.Common
@model IEnumerable<E_Commers_Adelia.Models.Order>
@inject UserManager<EUser> userManager
@inject ApplicationDbContext db
@{
    ViewData["Title"] = "Order Request";
    ViewData["OrderCount"] = Model.Where(x=>x.StatusId < OrderStatus.Completed.Id).Count();
}
<div class="d-flex align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
    <div>
        <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
        <h6 class="op-7 mb-2">You have @ViewData["OrderCount"] pending orders</h6>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="tab-content mt-2 mb-3" id="pills-tabContent">
            <div class="tab-pane fade show active" id="pills-neworder" role="tabpanel" aria-labelledby="pills-neworder-tab">
                <div class="card shadow rounded-3 mb-4">
                    <div class="card-header">
                        <div class="card-head-row card-tools-still-right">
                            <div class="card-title">
                                Order Transaction History
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <ul class="nav nav-pills nav-secondary" id="pills-tab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="pills-home-tab" data-bs-toggle="pill" href="#pills-home" role="tab" aria-controls="pills-home" aria-selected="true">In-Progress</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="pills-profile-tab" data-bs-toggle="pill" href="#pills-profile" role="tab" aria-controls="pills-profile" aria-selected="false">Completed</a>
                            </li>
                        </ul>
                        <div class="tab-content mt-2 mb-3" id="pills-tabContent">
                            <div class="tab-pane fade show active" id="pills-home" role="tabpanel" aria-labelledby="pills-home-tab">
                                <div class="card-list py-4">
                                    <!-- Modal -->
                                    @* <div class="modal fade"
                                         id="DeliveryInfo"
                                         tabindex="-1"
                                         role="dialog"
                                         aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered" role="document">
                                            <div class="modal-content text-center">
                                                <div class="modal-header border-0">
                                                    <h5 class="modal-title">
                                                        <span class="fw-mediumbold">Delivery info</span>
                                                        <span class="fw-light">#@($"#{order.OrderNo}")</span>
                                                    </h5>
                                                    <button type="button"
                                                            class="close"
                                                            data-bs-dismiss="modal"
                                                            aria-label="Close">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="modal-body text-center">
                                                    @if (payment.PaymentTypeId == PaymentMethod.OnlineTransfer.Id || payment.PaymentTypeId == PaymentMethod.QR.Id)
                                                    {
                                                        <div class="d-flex justify-content-center">
                                                            <img src="@(string.IsNullOrEmpty(payment.ResitUrl)
                                                                                                                                                                          ? Url.Content("~/img/blank.jpg")
                                                                                                                                                                          : Url.Content("~/" + payment.ResitUrl))"
                                                             alt="..."
                                                             class="img-fluid fa-caret-square-up "
                                                             style="max-width: 300px;height:auto" />
                                                    </div>
                                                                                                        }
                                                    <div class="table-responsive d-flex justify-content-center">
                                                        <table width="80%" class="mx-auto">
                                                            <tbody>
                                                                <tr>
                                                                    <th class="text-start">Date and Time</th>
                                                                    <td class="text-start">@payment.PaymentDate.ToLocalTime()</td>
                                                                </tr>
                                                                <tr>
                                                                    <th class="text-start">Amount</th>
                                                                    <td class="text-start">@($"RM{payment.Amount}")</td>
                                                                </tr>
                                                                <tr>
                                                                    <th class="text-start">Type</th>
                                                                    <td class="text-start">@PaymentMethod.All.FirstOrDefault(x => x.Id == payment.PaymentTypeId).Name</td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-0 justify-content-center">
                                                    <form asp-action="ComfirmPayment" asp-route-id="@order.OrderNo" method="post">
                                                        <button type="submit"
                                                                id="btnComfirm"
                                                                class="btn btn-primary"
                                                                style="width:125px;">
                                                            Confirm
                                                        </button>
                                                    </form>
                                                    <a class="btn btn-outline-danger"
                                                       data-bs-dismiss="modal" style="width:125px;">
                                                        Cancel
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div> *@
                                    @foreach (var order in Model.DistinctBy(x => x.OrderNo).OrderBy(x => x.UpdateDateTime).ToList())
                                    {

                                        var totalOrder = Model.Where(x => x.OrderNo == order.OrderNo).Count();
                                        var totalComplete = Model.Where(x => x.OrderNo == order.OrderNo && x.StatusId == OrderStatus.Completed.Id).Count();
                                        var totalCancel = Model.Where(x => x.OrderNo == order.OrderNo && (x.StatusId == OrderStatus.Cancelled.Id || x.StatusId == OrderStatus.UserCanceled.Id)).Count();
                                        var price = Model.Where(x => x.OrderNo == order.OrderNo).Select(x => x.SubTotalPrice).Sum();
                                        float percentCancel = ((float)totalCancel / totalOrder) * 100f;
                                        float percentComplete = ((float)totalComplete / totalOrder) * 100f;
                                        var customerName = string.IsNullOrWhiteSpace(order.CustomerId) ? db.CustomerDeliveryInfo.FirstOrDefault(x => x.OrderNo == order.OrderNo)?.CustomerName ?? "Unknown" : userManager.FindByIdAsync(order.CustomerId).Result?.DisplayName;
                                        var deliveryinfo = string.IsNullOrWhiteSpace(order.CustomerId) ? db.CustomerDeliveryInfo.FirstOrDefault(x => x.OrderNo == order.OrderNo) : db.CustomerDeliveryInfo.FirstOrDefault(x => x.CustomerId == order.CustomerId);
                                        var deliveryType = DeliveryOption.All.FirstOrDefault(x => x.Id == order.DeliveryId)?.Name ?? "Unknown";

                                    if ((percentComplete + percentCancel) < 100)
                                        {
                                            <div class="item-list">
                                                <div class="avatar">
                                                    <img src="@Url.Action("GetAvatar", "Profile", new { userId = order.CustomerId })"
                                                        alt="..."
                                                        class="avatar-img rounded-circle" />
                                        </div>
                                        <div class="info-user ms-3">
                                            <a asp-action="View"
                                               asp-controller="ProcessOrder"
                                               asp-route-id="@order.OrderNo"
                                               class="@(Model.FirstOrDefault(x=> x.OrderNo == order.OrderNo)?.StatusId < 3 ? "active":"") ">


                                                        <div class="username">@customerName </div>
                                                        <div class="status">@($"#{order.OrderNo}")</div>
                                                    </a>
                                                    <div class="delivery-info space-y-2 text-gray-700">
                                                        <div class="flex items-center gap-2">
                                                            <i class="fas fa-phone text-blue-500"></i>
                                                            <span>@deliveryinfo.CustomerPhone</span>
                                                        </div>
                                                        <div class="flex items-center gap-2">
                                                            <i class="fas fa-truck text-green-500"></i>
                                                            <span>@deliveryType</span>
                                                        </div>
                                                        <div class="flex items-center gap-2">
                                                            <i class="fas fa-home text-purple-500"></i>
                                                            <span>@deliveryinfo.Address</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <p class="">@($"{percentComplete}%")</p>
                                            </div>
                                            <hr/>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="pills-profile" role="tabpanel" aria-labelledby="pills-profile-tab">
                            <div class="card-list py-4">

                                @foreach (var order in Model.DistinctBy(x => x.OrderNo).OrderBy(x => x.UpdateDateTime).ToList())
                                {
                                    var totalOrder = Model.Where(x => x.OrderNo == order.OrderNo).Count();
                                    var totalComplete = Model.Where(x => x.OrderNo == order.OrderNo && x.StatusId == OrderStatus.Completed.Id).Count();
                                    var totalCancel = Model.Where(x => x.OrderNo == order.OrderNo && x.StatusId == OrderStatus.Cancelled.Id).Count();
                                    var price = Model.Where(x => x.OrderNo == order.OrderNo).Select(x => x.SubTotalPrice).Sum();
                                    float percentComplete = ((float)totalComplete / totalOrder) * 100f;
                                    float percentCancel = ((float)totalCancel / totalOrder) * 100f;
                                    var customerName = string.IsNullOrWhiteSpace(order.CustomerId) ? db.CustomerDeliveryInfo.FirstOrDefault(x => x.OrderNo == order.OrderNo)?.CustomerName ?? "Unknown" : userManager.FindByIdAsync(order.CustomerId).Result?.DisplayName;
                                    var deliveryinfo = string.IsNullOrWhiteSpace(order.CustomerId) ? db.CustomerDeliveryInfo.FirstOrDefault(x => x.OrderNo == order.OrderNo) : db.CustomerDeliveryInfo.FirstOrDefault(x => x.CustomerId == order.CustomerId);
                                    var deliveryType = DeliveryOption.All.FirstOrDefault(x => x.Id == order.DeliveryId)?.Name ?? "Unknown";
                                    if ((percentComplete + percentCancel) == 100)
                                    {
                                        <div class="item-list">
                                            <div class="avatar">
                                                <img src="@Url.Action("GetAvatar", "Profile", new { userId = order.CustomerId })"
        
                                                    alt="..."
                                                    class="avatar-img rounded-circle" />
                                            </div>
                                            <div class="info-user ms-3">
                                                <a asp-action="View"
                                                   asp-controller="ProcessOrder"
                                                   asp-route-id="@order.OrderNo"
                                                   class="@(Model.FirstOrDefault(x=> x.OrderNo == order.OrderNo).StatusId < 3 ? "text-primary":"text-muted")">


                                                    <div class="username">@customerName</div>
                                                    <div class="status">@($"#{order.OrderNo}")</div>

                                                </a>
                                                <div class="delivery-info space-y-2 text-gray-700">
                                                    <div class="flex items-center gap-2">
                                                        <i class="fas fa-phone text-blue-500"></i>
                                                        <span>@deliveryinfo?.CustomerPhone</span>
                                                    </div>
                                                    <div class="flex items-center gap-2">
                                                        <i class="fas fa-truck text-green-500"></i>
                                                        <span>@deliveryType</span>
                                                    </div>
                                                    <div class="flex items-center gap-2">
                                                        <i class="fas fa-home text-purple-500"></i>
                                                        <span>@deliveryinfo?.Address</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="text-end">

                                                @if (percentComplete == 100)
                                                {
                                                    <span class="badge badge-success">Completed</span>
                                                }
                                                else
                                                {
                                                    if (totalOrder > 1)
                                                    {
                                                        <span class="badge badge-success">@($"Completed ({totalComplete})")</span>
                                                        <span class="badge badge-danger">@($"Canceled ({totalCancel})")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-danger">@($"Canceled")</span>
                                                    }
                                                }
                                            </div>
                                        </div>

                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>