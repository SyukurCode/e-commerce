@model IEnumerable<E_Commers_Adelia.Models.Product>
@{
    ViewData["Title"] = "Your products";
    ViewData["ProductCount"] = Model.Count();
}
<div class="d-flex align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
    <div>
        <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
        <h6 class="op-7 mb-2">You have currently @ViewData["ProductCount"] products</h6>
    </div>
    <div class="ms-md-auto py-2 py-md-0">
        <a asp-action="Create" class="btn btn-primary btn-round">Add Product</a>
    </div>
</div>


<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="ProductTable"
                           class="display table table-striped table-hover">
                        <thead>
                            <tr>
                                <th style="width: 10%">Image</th>
                                <th>Product</th>
                                <th>Satus</th>
                                <th style="width: 10%">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Image -->
                                    <td>
                                        <div class="flex-shrink-0 me-3">
                                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? Url.Content("~/img/blank.jpg") : item.ImageUrl)"
                                                 alt="Product Image"
                                                 class="rounded"
                                                 style="width: 80px; height: 80px; object-fit: cover;" />
                                        </div>
                                    </td>
                                    <!-- Product -->
                                    <td class="info-user ms-3">
                                        <dl class="row">
                                            <dt class="col-sm-6">
                                                @Html.DisplayNameFor(modelItem => item.Name)
                                            </dt>
                                            <dd class="col-sm-6">
                                                @Html.DisplayFor(modelItem => item.Name)
                                            </dd>
                                            <dt class="col-sm-6">
                                                @Html.DisplayNameFor(modelItem => item.Description)
                                            </dt>
                                            <dd class="col-sm-6">
                                                @Html.DisplayFor(modelItem => item.Description)
                                            </dd>
                                            <dt class="col-sm-6">
                                                @Html.DisplayNameFor(modelItem => item.Price)
                                            </dt>
                                            <dd class="col-sm-6">
                                                @Html.DisplayFor(modelItem => item.Price)
                                            </dd>
                                            <dt class="col-sm-6">
                                                @Html.DisplayNameFor(modelItem => item.Stock)
                                            </dt>
                                            <dd class="col-sm-6">
                                                @Html.DisplayFor(modelItem => item.Stock)
                                            </dd>
                                        </dl>
                                    </td>
                                    <!-- Status -->
                                    <td>
                                        <span class="badge @((item.isEnable && item.Stock>0) ? "badge-success" : "badge-danger")">
                                            @((item.isEnable && item.Stock > 0) ? "Available" : "Not Available")
                                        </span>
                                        <span class="badge @(item.isHide ? "badge-danger" : "badge-success")">
                                            @(item.isHide ? "Hide" : "Show")
                                        </span>
                                    </td>
                                    <!-- Action -->
                                    <td>
                                        <div class="form-button-action">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               data-bs-toggle="tooltip"
                                               title="Detail"
                                               class="btn btn-link btn-primary btn-lg"
                                               data-original-title="Details">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_NotificationPartial" />
    <partial name="_ProductDataTableScriptPartial" />
}