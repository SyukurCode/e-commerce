@model IEnumerable<E_Commers_Adelia.Models.Product>
@{
    ViewData["Title"] = "Your products";
    ViewData["ProductCount"] = Model.Count();
}
<div class="d-flex align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
    <div>
        <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
        <h6 class="op-7 mb-2">You have currently @ViewData["ProductCount"] products</h6>
    </div>
    <div class="ms-md-auto py-2 py-md-0">
        <a asp-action="Create" class="btn btn-primary btn-round">Add Product</a>
    </div>
</div>


<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="ProductTable"
                    class="display table table-striped table-hover">
                        <thead>
                            <tr>
                                <th style="width: 10%">Image</th>
                                <th>@Html.DisplayNameFor(Model => Model.Name)</th>
                                <th style="width: 10%">@Html.DisplayNameFor(Model => Model.isEnable)</th>
                                <th style="width: 10%">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="flex-shrink-0 me-3">
                                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? Url.Content("~/img/blank.jpg") : item.ImageUrl)"
                                            alt="Product Image"
                                            class="rounded"
                                            style="width: 80px; height: 80px; object-fit: cover;" />
                                        </div>
                                    </td>
                                    <td class="info-user ms-3">
                                        <div class="username"><strong>@Html.DisplayFor(modelItem => item.Name)</strong></div>
                                        <div class="status">@Html.DisplayFor(modelItem => item.Description)</div>
                                    </td>
                                    <td>
                                        <span class="badge @(item.isEnable ? "badge-success" : "badge-secondary")">
                                            @(item.isEnable ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="form-button-action">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                            data-bs-toggle="tooltip"
                                            title="Detail"
                                            class="btn btn-link btn-primary btn-lg"
                                            data-original-title="Details">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            @if (item.isEnable)
                                            {
                                                <form id="@item.Id" asp-action="ToggleEnableProduct" asp-route-id="@item.Id" method="post">
                                                <button type="button" 
                                                data-bs-toggle="tooltip"
                                                title="Disable"
                                                class="btn btn-link btn-danger btn-lg"
                                                data-original-title="" 
                                                onclick="submitDisable('@item.Id')">
                                                    <i class="fa fa-power-off"></i>
                                                </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="ToggleEnableProduct" asp-route-id="@item.Id" method="post">
                                                <button type="submit" 
                                                   data-bs-toggle="tooltip"
                                                   title="Enable"
                                                   class="btn btn-link btn-danger btn-lg"
                                                   data-original-title="">
                                                    <i class="fa fa-power-off"></i>
                                                </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ProductDataTableScriptPartial" />
}