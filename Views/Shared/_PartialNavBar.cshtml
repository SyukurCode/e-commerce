@using E_Commers_Adelia.Repository
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Http;
@using E_Commers_Adelia.Common
@inject IHttpContextAccessor HttpContextAccessor
@inject UserManager<EUser> UserManager
@inject SignInManager<EUser> SignInManager
@inject ApplicationDbContext db
@inject INotification notify
@{
    var notiCount = 0;
    IEnumerable<Notification> noti = new List<Notification>();
    if (SignInManager.IsSignedIn(User)) {
        var currentUser = await UserManager.GetUserAsync(User);
        
        noti = await notify.GetByUser(currentUser.Id);
        notiCount = noti.Where(n => n.IsRead == false).Count();
    }
    var cart = HttpContextAccessor.HttpContext.Session.GetObjectFromJson<List<CartItem>>("Cart") ?? new List<CartItem>();
    ViewData["CartNoti"] = cart.Sum(x => x.Quantity);
    ViewData["Avatar"] = Url.Action("GetAvatar", "Profile", new { userId = UserManager.GetUserId(User)});
}
