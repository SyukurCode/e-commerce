@model IEnumerable<E_Commers_Adelia.Models.Order>
@inject ApplicationDbContext db

@{
    ViewData["Title"] = "Your Order";
    decimal total = 0;
}

<div class="page-header">
    <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-action="Index" asp-controller="Home">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">@ViewData["OrderNo"]</a>
        </li>
    </ul>
</div>
<hr />
<div class="card shadow rounded-3 mb-4">
    <div class="card-header">
        <div class="card-head-row">
            <div class="card-title mb-0 text-primary"># @ViewData["OrderNo"]</div>
            <div class="card-tools">
                <a asp-action="Index" asp-controller="OrderTracking" asp-route-orderNo="@ViewData["OrderNo"]" class="btn btn-label-info btn-round btn-sm">
                    <span class="btn-label">
                        <i class="fas fa-map-marker"></i>
                    </span>
                    Track
                </a>
            </div>
        </div>
    </div>
    <div class="card-body text-center">
        @foreach (var item in Model)
        {
            <div class="row align-items-center">
                <!-- Product Image -->
                <div class="col-3 col-md-2 text-center">
                    <img src="@(string.IsNullOrEmpty(item.ProductImageUrl)
                                                                                          ? Url.Content("~/img/blank.jpg")
                                                                                          : Url.Content("~/" + item.ProductImageUrl))"
                     alt="..."
                     class="img-fluid fa-behance-square"
                     style="max-width: 60px;height:auto" />
            </div>

                <!-- Product Info -->
                <div class="col-9 col-md-5 text-start">
                    <h5 class="fw-bold text-danger">@($"RM{item.UnitPrice}")</h5>
                    <div class="fw-bold">@item.ProductName</div>
                    <div class="text-muted small">@item.ProductDescription</div>
                @if (item.SelectedOption != null && item.SelectedOption.Any())
                    {
                        var options = item.SelectedOption.Split("\r\n");
                        <div class="fw-bold">Options:</div>
                        foreach (var option in options)
                        {
                            <div class="text-muted small">
                                <span class="badge bg-info text-dark text-wrap me-1 mb-1">
                                    @option
                                </span>
                            </div>
                        }
                    }
                </div>
                <!-- Quantity & Price -->
                <div class="col-12 col-md-12 mt-2 mt-md-0 nav-color-light">
                    <div class="d-flex justify-content-between justify-content-md-end gap-md-3">
                        <span>Subtotal:</span>
                        <span>x @item.Quantity</span>
                        <span class="fw-bold">RM<span id="@($"totalPrice{item.Id}")">@item.SubTotalPrice</span></span>
                    </div>
                </div>
            </div>

            total += item.SubTotalPrice;
            <hr />
        }
        @{
            var DeliveryCharge = Model.First().ExtraCharges;
            total = total + DeliveryCharge;
        }
        <div class="col-12 col-md-12 mt-2 mt-md-0">
            <div class="d-flex justify-content-between justify-content-md-end gap-md-3">
                <div>
                    <p>Delivery Charge:</p>
                    <h5 class="text-end fw-bold">Total:</h5>
                </div>
                <div>
                    <p class="text-end">@($"RM{DeliveryCharge}")</p>
                    <h5 class="fw-bold">RM<span>@total</span></h5>
                </div>
            </div>
        </div>
    </div>
</div>
