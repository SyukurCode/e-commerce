@model IEnumerable<E_Commers_Adelia.Models.Order>
@inject ApplicationDbContext db

@{
    ViewData["Title"] = "Your Order";
    decimal total = 0;
}

<div class="page-header">
    <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-action="Index" asp-controller="Home">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">@ViewData["OrderNo"]</a>
        </li>
    </ul>
</div>
<hr />
<div class="card shadow rounded-3 mb-4">
    <div class="card-header d-flex justify-content-between align-items-center bg-light border-0">
        <h5 class="card-title mb-0 text-primary"># @ViewData["OrderNo"]</h5>
        <span></span>
    </div>
    <div class="card-body text-center">
        @foreach (var item in Model)
        {
            
            var product = await db.Products.FindAsync(item.ProductId);
            <div class="row align-items-center">
                <!-- Product Image -->
                <div class="col-3 col-md-2 text-center">
                    <img src="@(string.IsNullOrEmpty(product.ImageUrl)
                                        ? Url.Content("~/img/blank.jpg")
                                        : Url.Content("~/" + product.ImageUrl))"
                    alt="..."
                    class="img-fluid fa-behance-square"
                    style="max-width: 60px;height:auto" />
                </div>

                <!-- Product Info -->
                <div class="col-9 col-md-5 text-start">
                    <h5 class="fw-bold text-danger">@($"RM{item.UnitPrice}")</h5>
                    <div class="fw-bold">@product.Name</div>
                    <div class="text-muted small">@product.Description</div>
                    @if (item.SelectedOption != null && item.SelectedOption.Any())
                    {
                        var options = item.SelectedOption.Split("\r\n");
                        <div class="fw-bold">Options:</div>
                        foreach (var option in options)
                        {
                            <div class="text-muted small">
                                <span class="badge bg-info text-dark text-wrap me-1 mb-1">
                                    @option
                                </span>
                            </div>
                        }
                    }
                </div>
                <!-- Quantity & Price -->
                <div class="col-12 col-md-12 mt-2 mt-md-0 nav-color-light">
                    <div class="d-flex justify-content-between justify-content-md-end gap-md-3">
                        <span>Subtotal:</span>
                        <span>x @item.Quantity</span>
                        <span class="fw-bold">RM<span id="@($"totalPrice{item.Id}")">@item.SubTotalPrice</span></span>
                    </div>
                </div>
            </div>

            total += item.SubTotalPrice;
            <hr/>
        }
        <div class="col-12 col-md-12 mt-2 mt-md-0">
            <div class="d-flex justify-content-between justify-content-md-end gap-md-3">
                <span>Total:</span>
                <span class="fw-bold">RM<span>@total</span></span>
            </div>
        </div>
        <!-- Total To Pay -->
        @* <div class="position-relative p-3"> *@
        @*     <!-- Center: Total label --> *@
        @*     <div class="position-absolute top-50 start-50 translate-middle"> *@
        @*         <h3 class="mb-0 fw-bold">Total(@Model.Count())</h3> *@
        @*     </div> *@

        @*     <!-- End: RM and TotalToPay --> *@
        @*     <div class="position-absolute top-50 end-0 translate-middle-y d-flex align-items-end gap-2 me-3"> *@
        @*         <span class="mb-0">RM</span> *@
        @*         <h3 id="totalToPay" class="mb-0 text-decoration-underline">0.00</h3> *@
        @*     </div> *@
        @* </div> *@
    </div>
</div>
