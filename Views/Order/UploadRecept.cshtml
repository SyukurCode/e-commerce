@model E_Commers_Adelia.Models.CustomerPayment

@{
    ViewData["Title"] = "Payment Receipt";
}

<div class="page-header">
    <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-action="Index" asp-controller="Home">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">@Model.OrderNo</a>
        </li>
    </ul>
</div>
<hr />
<div class="card shadow rounded-3 mb-4">
        <form asp-action="UploadRecept" enctype="multipart/form-data">
        @* Hidden fields *@
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="OrderNo" />
            <input type="hidden" asp-for="PaymentTypeId" />
            <input type="hidden" asp-for="Amount" />
            <input type="hidden" asp-for="PaymentDate" />
            <input type="hidden" asp-for="PaymentComfirmation" />
            <input type="hidden" asp-for="PaymentComfrmDate" />

            <div class="card-header bg-light border-0">
                <h5 class="card-title text-primary m-0">Upload Receipt</h5>
            </div>

            <div class="d-flex flex-column align-items-center gap-3 p-3">
                <img src="@Url.Content("~/img/blank.jpg")"
                     alt="Receipt-Image"
                     class="img-fluid rounded"
                     style="max-height: 250px; object-fit: contain;"
                     id="UploadedImage" />

                <div class="btn-group w-100 justify-content-center mb-3 text-center gap-4">
                    <label for="upload" class="btn btn-primary d-flex justify-content-center align-items-center" style="max-width: 125px;">
                        <span class="d-sm-inline">Upload</span>
                        <i class="bx bx-upload d-inline d-sm-none fs-4"></i>
                    </label>
                    <button type="submit" class="btn btn-success" style="max-width: 125px;">
                        Save
                    </button>
                </div>
                <input type="file"
                       name="image"
                       id="upload"
                       class="account-file-input"
                       hidden
                       accept="image/png, image/jpeg, application/pdf" />
            </div>

        </form>
</div>

