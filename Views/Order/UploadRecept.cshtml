@model E_Commers_Adelia.Models.CustomerPayment

@{
    ViewData["Title"] = "Payment Receipt";
}

<div class="page-header">
    <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-action="Index" asp-controller="Home">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">@Model.OrderNo</a>
        </li>
    </ul>
</div>
<hr />
<div class="row">
    <div class="col-md-4">
        <div class="card shadow rounded-3 mb-4">
            <form asp-action="UploadRecept" enctype="multipart/form-data">

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="OrderNo" />
                <input type="hidden" asp-for="PaymentTypeId" />
                <input type="hidden" asp-for="Amount" />
                <input type="hidden" asp-for="PaymentDate" />
                <input type="hidden" asp-for="PaymentComfirmation" />
                <input type="hidden" asp-for="PaymentComfrmDate" />


                <div class="card-header d-flex justify-content-between align-items-center bg-light border-0 position-relative">
                    <h5 class="card-title mb-0 text-primary text-start">Upload payment recept</h5>
                </div>

                <div class="form-group">
                    <label for="upload-recept"></label>
                    <input type="file"
                           name="image"
                           class="form-control-file"
                           id="upload-recept" 
                           accept="image/png, image/jpeg" />/>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                </div>
                <div class="card-footer text-end">
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary  rounded-pill"><i class="fa fa-paper-plane"></i> Send</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

