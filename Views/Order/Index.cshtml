@model E_Commers_Adelia.Models.OrderDetails

@{
    ViewData["Title"] = "Index";
}
<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="row w-100 justify-content-center">
        <div class="col-md-6">
            <div class="card card-round">
                <div class="card-body">
                    <form asp-action="Index" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Hidden fields for Product -->
                        <input type="hidden" asp-for="Product.userId" />
                        <input type="hidden" asp-for="Product.Description" />
                        <input type="hidden" asp-for="Product.Name" />
                        <input type="hidden" asp-for="Product.Id" />
                        <input type="hidden" asp-for="Product.Price" />
                        <input type="hidden" asp-for="Product.ImageUrl" />
                        <!-- Product Image -->
                        <div class="text-center mb-3">
                            <img src="@(string.IsNullOrEmpty(Model?.Product.ImageUrl) ? Url.Content("~/img/blank.jpg") : Url.Content("~/" + Model.Product.ImageUrl))"
                                 alt="Product Image"
                                 class="rounded"
                                 style="width: 200px; height: 200px; object-fit: cover;" />
                        </div>

                        <!-- Product Info -->
                        <dl class="row">
                            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Product.Price)</dt>
                            <dd class="col-sm-8 text-danger">
                                <span class="fs-5">
                                    <small class="me-1">RM</small>@Html.DisplayFor(m => m.Product.Price)
                                </span>
                            </dd>

                            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Product.Name)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(m => m.Product.Name)</dd>

                            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Product.Description)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(m => m.Product.Description)</dd>
                        </dl>

                        <!-- Options Checkbox -->
                        <div class="mb-3">
                            @if (Model.Product.Options.Count > 0)
                            {
                                <label class="form-label fw-semibold">Options</label>
                                @for (int i = 0; i < Model.Product.Options.Count; i++)
                                {
                                    <div class="form-check d-flex align-items-center justify-content-between border-bottom py-2">
                                        <input type="checkbox"
                                               name="SelectedOptionIds"
                                               value="@Model.Product.Options[i].Id"
                                               class="form-check-input"
                                               id="option_@Model.Product.Options[i].Id" />
                                        <label class="form-check-label w-100" for="option_@Model.Product.Options[i].Id">
                                            <div class="d-flex justify-content-between">
                                                <span>@Model.Product.Options[i].OptionName</span>
                                                <span class="text-muted">+RM @Model.Product.Options[i].AdditionalPrice.ToString("0.00")</span>
                                            </div>
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                        <!-- Quantity Selector -->
                        <div class="form-group">
                            <label asp-for="Quantity" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <button class="btn btn-outline-secondary" type="button" onclick="changeQuantity(-1)">−</button>
                                <input asp-for="Quantity" type="number" id="quantity" value="1" class="form-control text-center" min="1" />
                                <button class="btn btn-outline-secondary" type="button" onclick="changeQuantity(1)">+</button>
                            </div>
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="form-group text-center">
                            <input type="submit" name="action" value="BuyNow" class="btn btn-primary" />
                            <input type="submit" name="action" value="AddToCart" class="btn btn-outline-secondary" />
                        </div>
                        <div class="text-center">
                            <a asp-action="Index" asp-controller="Home">Back to menu</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_NotificationPartial" />
}