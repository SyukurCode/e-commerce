@model E_Commers_Adelia.Models.CustomerPayment

@{
    ViewData["Title"] = "Payment Receipt";
}

<div class="page-header">
    <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-action="Index" asp-controller="Home">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">@Model.OrderNo</a>
        </li>
    </ul>
</div>
<hr />
<div class="card shadow rounded-3 mb-4">
        <!-- Loading Modal -->
    <div class="modal fade" id="loadingModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false" style="background-color: rgba(0, 0, 0, 0.85)">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content text-center border-0 bg-transparent shadow-none">
                    <div class="modal-body">
                        <div class="spinner-border text-primary" style="width: 4rem; height: 4rem;" role="status"></div>
                        <h5 class="mt-3 text-white">Verifying your receipt...</h5>
                        <p class="text-white-50 small">Please wait a moment</p>
                    </div>
                </div>
            </div>
        </div>
        <form asp-action="UploadReceipt" enctype="multipart/form-data">
        @* Hidden fields *@
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="OrderNo" />
            <input type="hidden" asp-for="PaymentTypeId" />
            <input type="hidden" asp-for="Amount" />
            <input type="hidden" asp-for="PaymentDate" />
            <input type="hidden" asp-for="PaymentComfirmation" />
            <input type="hidden" asp-for="PaymentComfrmDate" />

            <div class="card-header bg-light border-0">
                <h5 class="card-title text-primary m-0">Upload Recept</h5>
            </div>

            <div class="d-flex flex-column align-items-center gap-3 p-3">
                <p>Please screenshoot and upload your payment receipt </p>
                <img src="@Url.Content("~/img/blank.jpg")"
                     alt="Receipt-Image"
                     class="img-fluid rounded"
                     style="max-height: 250px; object-fit: contain;"
                     id="UploadedImage" />

                <div class="btn-group w-100 justify-content-center mb-3 text-center gap-4">
                    <label for="upload" class="btn btn-primary d-flex justify-content-center align-items-center" style="max-width: 125px;">
                        <span class="d-sm-inline text-white">Upload</span>
                        <i class="bx bx-upload d-inline d-sm-none fs-4"></i>
                    </label>
                <button type="submit" class="btn btn-success" style="max-width: 125px;" onclick="showLoadingModal()">
                        Send
                    </button>
                <a asp-action="Cancel" asp-route-orderNo="@Model.OrderNo" class="btn btn-outline-secondary" style="max-width: 125px;">Cancel</a>
                </div>
                <input type="file"
                       name="image"
                       id="upload"
                       class="account-file-input"
                       hidden
                       accept="image/png, image/jpeg, application/pdf" />
            </div>

        </form>
</div>
@section Scripts
{
    <partial name="_ImageUploadScripsPartial" />
    <partial name="_NotificationPartial" />
    <partial name="_ValidationScriptsPartial" />
    <partial name="_UploadReceiptScriptsPartial" />
}