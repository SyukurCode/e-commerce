@using Microsoft.AspNetCore.Identity
@model E_Commers_Adelia.Models.CartView
@inject UserManager<EUser> userManager

@{
    ViewData["Title"] = "Cart Items";

}

<div class="page-header">
    <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-action="Index" asp-controller="Home">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Cart</a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Cart Items</a>
        </li>
    </ul>
</div>
<hr />
<div class="row">
    @if (Model.Seller.Count > 0)
    {
        @foreach (var seller in Model.Seller)
        {
            var shopOwnwer = await userManager.FindByIdAsync(seller);
            <div class="col-md-12">
                <div class="card card-round">
                    <div class="card-body">
                        <div class="card-head-row card-tools-still-right">
                            <div class="card-title"># @shopOwnwer.StoreName</div>
                        </div>
                        <hr />
                        <!-- Item List -->

                        <div class="card-list py-4">

                            @foreach (var item in Model.ItemCart)
                            {
                                @if (shopOwnwer.Id == item.Product.userId)
                                {
                                    <input id="@($"price{item.Id}")" asp-for="@item.UnitPrice" type="hidden" />
                                    <input asp-for="@item.Quantity" type="hidden" />
                                    <div class="item-list d-flex align-items-center flex-wrap gap-3 py-3 border-bottom">
                                        <!-- Product Image & Info -->
                                        <div class="d-flex align-items-center flex-grow-1" style="min-width: 200px;">
                                            <img src="@(string.IsNullOrEmpty(item.Product.ImageUrl) ? Url.Content("~/img/blank.jpg") : Url.Content("~/" + item.Product.ImageUrl))"
                                                 alt="..."
                                                 class="avatar-img rounded-circle me-3"
                                                 style="width: 50px; height: 50px;" />
                                            <div>
                                                <div class="fw-bold">@item.Product.Name</div>
                                                <div class="text-muted small">@item.Product.Description</div>
                                            </div>
                                        </div>


                                        <!-- Option -->
                                        @if (item.SelectedOptions.Count() > 0)
                                        {
                                            <div class="text-nowrap me-3">
                                                <div class="fw-bold">Option</div>
                                                <div class="d-flex flex-column">
                                                    @foreach (var option in item.SelectedOptions)
                                                    {
                                                        <span class="text-muted small">
                                                            +RM @option.AdditionalPrice @option.OptionName
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }


                                        <div class="text-nowrap me-3">
                                            <div class="fw-bold">RM @item.UnitPrice</div>
                                        </div>
                                        <!-- Quantity -->
                                        <div class="text-nowrap me-3">
                                            @Html.AntiForgeryToken()
                                            <span>x @item.Quantity</span>
                                        </div>
                                        <!-- Total Price -->
                                        <div class="text-nowrap me-3">
                                            <small class="me-1">RM</small>
                                            <span id="@($"totalPrice{@shopOwnwer.Id}")">@item.TotalPrice.ToString("0.00")</span>
                                        </div>

                                        <!-- Delete Button -->
                                        <div class="text-nowrap">
                                            <form asp-action="RemoveCartItem" asp-route-id="@item.Id" method="post" class="m-0">
                                                <button class="btn btn-sm btn-outline-danger" type="submit" data-bs-toggle="tooltip" title="Remove">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>

                                    </div>
                                }
                            }
                            <div class="card-footer">
                                <div class="d-flex flex-wrap justify-content-between align-items-center pt-4 mt-4">

                                    <!-- Left: Total label -->
                                    <div class="d-flex align-items-center">
                                        <h5 class="mb-0 fw-bold">
                                            Total (<span class="text-primary">@Model.ItemCart.Where(i => i.Product.userId == shopOwnwer.Id).Count()</span> item@((Model.ItemCart.Where(i => i.Product.userId == shopOwnwer.Id).Count() > 1) ? "s" : "")):
                                        </h5>
                                    </div>

                                    <!-- Center: Total Amount -->
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-5">RM</span>
                                        <h3 id="@($"totalToPay{@shopOwnwer.Id}") class="mb-0 text-danger fw-bold text-decoration-underline">
                                            @ViewData[shopOwnwer.Id]
                                        </h3>
                                    </div>

                                    <!-- Right: Checkout button -->
                                    <div>
                                        <a asp-action="checkoutCartItem" asp-route-id="@shopOwnwer.Id" class="btn btn-primary px-4">
                                            Checkout
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts
{
    <partial name="_CartScriptsPartial" />
}