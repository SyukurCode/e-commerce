@using Microsoft.AspNetCore.Identity
@model IEnumerable<E_Commers_Adelia.Models.CartItem>
@inject UserManager<EUser> UserManager

@{
    ViewData["Title"] = "Cart Items";
    
}

<div class="page-header">
    <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-action="Index" asp-controller="Home">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Cart</a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Cart Items</a>
        </li>
    </ul>
</div>
<hr />
<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="row w-100 justify-content-center">
        <div class="col-md-6">
            @foreach (var item in Model)
            {
                <input id="cardId" type="hidden" value="@item.Id" />
                var user = await UserManager.FindByIdAsync(item.Product.userId);
                <div class="card shadow rounded-3 mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center bg-light border-0">
                        <h5 class="card-title mb-0 text-primary"># @user.StoreName</h5>
                        <form asp-action="RemoveCartItem" asp-route-id="@item.Id" method="post" class="m-0">
                            <button class="btn btn-sm btn-outline-danger" type="submit" data-bs-toggle="tooltip" title="Remove">
                                <i class="fa fa-trash"></i>
                            </button>
                        </form>
                    </div>

                    <div class="card-body text-center">
                        <!-- Product Image -->
                        <div class="mb-3">
                            <img src="@(string.IsNullOrEmpty(item.Product.ImageUrl) ? Url.Content("~/img/blank.jpg") : Url.Content("~/" + item.Product.ImageUrl))"
                                 alt="Product Image"
                                 class="rounded shadow-sm"
                                 style="width: 200px; height: 200px; object-fit: cover;" />
                        </div>

                        <!-- Product Info -->
                        <h6 class="text-dark fw-semibold mb-1">@item.Product.Name</h6>
                        <p class="text-muted small">@item.Product.Description</p>

                        <!-- Unit Price -->
                        <div class="text-danger fs-5 mb-2">
                            <small class="me-1">RM</small>
                            <span id="@($"price{item.Id}")">@item.UnitPrice</span>
                        </div>

                        <!-- Options -->
                        @if (item.SelectedOptions != null && item.SelectedOptions.Any())
                        {
                            <div class="mb-3">
                                <label class="fw-semibold d-block mb-2">Options:</label>
                                @foreach (var option in item.SelectedOptions)
                                {
                                    <span class="badge bg-info text-dark me-1 mb-1">
                                        +RM @option.AdditionalPrice @option.OptionName
                                    </span>
                                }
                            </div>
                        }

                        <!-- Quantity Control -->
                        @Html.AntiForgeryToken()
                        <div class="form-group mb-4">
                            <label class="form-label fw-semibold">Quantity</label>
                            <div class="input-group justify-content-center">
                                <button type="button" class="btn btn-outline-secondary" onclick="changeCartQuantity(-1,'@item.Id')">−</button>
                                <input type="number" id="@item.Id" name="quantity" value="@item.Quantity"
                                       class="form-control text-center mx-2" style="max-width: 80px;" min="1"/>
                                <button type="button" class="btn btn-outline-secondary" onclick="changeCartQuantity(1,'@item.Id')">+</button>
                            </div>
                        </div>

                        <!-- Total Price -->
                        <div class="bg-light rounded p-3">
                            <div class="d-flex justify-content-center align-items-center gap-2">
                                <span class="fw-semibold">Total:</span>
                                <h4 class="mb-0 text-success">RM<span id="@($"totalPrice{item.Id}")">@item.TotalPrice</span></h4>
                            </div>
                        </div>
                    </div>
                </div>

            }
            @if (Model.Count() > 0)
            {
                <div class="card card-round">
                    <div class="d-flex justify-content-between align-items-center p-3">
                        <!-- Left: Total label -->
                        <div>
                            <h3 class="mb-0 fw-bold">Total(@Model.Count())</h3>
                        </div>

                        <!-- Center: RM and TotalToPay -->
                        <div class="text-center mx-auto d-flex align-items-center gap-2">
                            <span class="mb-0">RM</span>
                            <h3 id="totalToPay" class="mb-0 text-decoration-underline">@ViewData["TotalToPay"]</h3>
                        </div>

                        <!-- Right: Checkout button -->
                        <div>
                            <a asp-action="checkoutCartItem" class="btn btn-primary">Checkout</a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center">
                    <h1>No Item in cart</h1>
                    <a asp-action="Index" asp-controller="Home">Back to Menu</a>
                </div>
            }
        </div>
    </div>
</div>
@section Scripts
{
    <partial name="_CartScriptsPartial" />
}