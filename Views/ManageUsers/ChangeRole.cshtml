@model UserRole
@{
    ViewData["Title"] = "User Roles";
}
<div class="page-header">
    <h3 class="fw-bold mb-3">User Management</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-action="Index" asp-controller="Home">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a asp-action="Index">User Management</a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">@ViewData["Title"]</a>
        </li>
    </ul>
</div>
<hr />
<div class="row">
    <div class="col-md-6">

        <form asp-action="ChangeRole" method="post">
            <input type="hidden" asp-for="EUser.Id" />
            <input type="hidden" asp-for="EUser" />
            <div class="card  card-post card-round">
                <div class="card-header">
                    <div class="card-head-row card-tools-still-right">
                        <div class="card-title">Product</div>
                    </div>
                </div>
                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="EUser.DisplayName" class="form-control" readonly />
                        <label asp-for="EUser.DisplayName" class="form-label"></label>
                        <span asp-validation-for="EUser.DisplayName" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Roles">Roles</label>
                        <select asp-for="Roles" asp-items="ViewBag.AllRoles" multiple class="form-control border-0 shadow">
                        </select>
                        <span asp-validation-for="Roles" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="text-center align-content-between">
                        <input type="submit" value="Save" class="btn btn-primary m-1" />
                        <a class="btn btn-outline-secondary m-1" onclick="history.back()">Back</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>