@using Microsoft.AspNetCore.Identity
@model IEnumerable<E_Commers_Adelia.Models.Product>
@inject UserManager<EUser> UserManager
@{

    ViewData["Title"] = "Menu";
    ViewData["ProductCount"] = Model.Count();
}
<div class="d-flex align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
    <div>
        <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
        <h6 class="op-7 mb-2">Total @ViewData["ProductCount"] menu available</h6>
    </div>
</div>


<div class="row">
    @if(Model.Count() > 0)
    {
    @foreach (var item in Model)
    {
        var user = await UserManager.FindByIdAsync(item.userId);
        if (user != null)
        {
            @if (!item.isHide)
            {
                @if (item.isEnable && item.Stock > 0)
                {
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
                        <a asp-action="Index" asp-controller="Order" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                            <div class="card h-100 border-0 shadow-lg rounded-4 overflow-hidden">

                                <!-- Header -->
                                <div class="card-header bg-light border-0 rounded-top-4 py-2">
                                    <div class="small text-muted">
                                       <i class="fa fa-store">  </i><strong class="ms-2">@user.StoreName</strong>
                                    </div>
                                </div>

                                <!-- Body -->
                                <div class="card-body d-flex flex-column p-3 text-center">

                                    <!-- Product Image -->
                                    <div class="mb-3">
                                        <div class="ratio ratio-16x9 rounded shadow-sm bg-light mx-auto">
                                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? Url.Content("~/img/blank.jpg") : item.ImageUrl)"
                                                 alt="Product Image"
                                                 class="img-fluid rounded"
                                                 style="object-fit:cover;" />
                                        </div>
                                    </div>

                                    <!-- Product Info -->
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1 fw-semibold text-truncate">@item.Name</h6>
                                        <small class="text-muted d-block text-truncate">@item.Description</small>
                                        <h5 class="text-primary mt-2 mb-0">RM @item.Price</h5>

                                        @if (item != null && item.Stock > 0 && item.Stock < 3)
                                        {
                                            <span class="text-danger small">Last @item.Stock items</span>
                                        }
                                            else if (item != null && item.Stock == 0)
                                        {
                                            <span class="text-danger small">Sold Out</span>
                                        }
                                    </div>

                                </div>
                            </div>
                        </a>
                    </div>
                }
                else
                {
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4 opacity-50">

                            <div class="card h-100 border-0 shadow-lg rounded-4 overflow-hidden">

                                <!-- Header -->
                                <div class="card-header bg-light border-0 rounded-top-4 py-2">
                                    <div class="small text-muted">
                                        <i class="fa fa-store"></i><strong class="ms-2">@user.StoreName</strong>
                                    </div>
                                </div>

                                <!-- Body -->
                                <div class="card-body d-flex flex-column p-3 text-center">

                                    <!-- Product Image -->
                                    <div class="mb-3">
                                    <div class="ratio ratio-16x9 rounded shadow-sm bg-light mx-auto">
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? Url.Content("~/img/blank.jpg") : item.ImageUrl)"
                                             alt="Product Image"
                                             class="img-fluid rounded"
                                             style="object-fit:cover;" />
                                    </div>
                                    </div>

                                    <!-- Product Info -->
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1 fw-semibold text-truncate">@item.Name</h6>
                                        <small class="text-muted d-block text-truncate">@item.Description</small>
                                        <h5 class="text-primary mt-2 mb-0">RM @item.Price</h5>

                                    @if (!item.isEnable)
                                    {
                                        <span class="text-danger small">Not Available</span>
                                    }

                                    @if (item.Stock == 0)
                                    {
                                        <span class="text-danger small">Sold Out</span>
                                    }
                                    </div>

                                </div>
                            </div>

                    </div>
                }
            }
        }
    }
    }
</div>
@section Scripts
{
    <partial name="_NotificationPartial" />
}