@using E_Commers_Adelia.Common
@using Microsoft.AspNetCore.Identity
@model E_Commers_Adelia.Models.SellerPaymentMethod
@inject UserManager<EUser> UserManager
@{
    ViewData["Title"] = "Payment Option";
    var paymentOption = PaymentMethod.All.FirstOrDefault(p => p.Id == Model.PaymentMethodId);
}

<div class="page-header">
    <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-action="Index">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Detail</a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Edit</a>
        </li>
    </ul>
</div>
<hr />


<form asp-action="EditCOD">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PaymentMethodId" />
    <input type="hidden" asp-for="UserId" />
    <div class="col-md-12">
        <div class="card card-round">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-2">
                        Payment Option
                    </dt>
                    <dd class="col-sm-10">
                        @paymentOption.Name
                    </dd>
                    <dt class="col-sm-2">
                        Detail
                    </dt>
                    <dd class="col-sm-10">
                        @paymentOption.Detail
                    </dd>
                </dl>

                <div class="form-group form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" asp-for="isEnable" />
                    <label class="form-check-label" asp-for="isEnable"> </label>
                    <span asp-validation-for="isEnable" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="card card-round">
            <div class="card-body">
                <div class="form-floating mb-3">
                    <input name="codNote" class="form-control" value="@ViewData["CodNote"]" />
                   <label for="codNote" class="form-label">Message to customer</label>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="card card-round">
            <div class="card-body">
                <div class="form-group text-center">
                    <input type="submit" value="Save" class="btn btn-primary" />
                    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
                </div>
            </div>
        </div>
    </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_ImageUploadScripsPartial" />
    <partial name="_NotificationPartial" />
    }
