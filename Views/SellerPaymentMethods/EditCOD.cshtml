@using E_Commers_Adelia.Common
@using Microsoft.AspNetCore.Identity
@model E_Commers_Adelia.Models.EditCODView
@inject UserManager<EUser> UserManager
@{
    ViewData["Title"] = "Payment Option";
    var paymentOption = PaymentMethod.All.FirstOrDefault(p => p.Id == Model.PaymentOption.PaymentMethodId);
}

<div class="page-header">
    <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-action="Index">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Detail</a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Edit</a>
        </li>
    </ul>
</div>
<hr />


<form asp-action="EditCOD">
    <input type="hidden" asp-for="PaymentOption.Id" />
    <input type="hidden" asp-for="PaymentOption.PaymentMethodId" />
    <input type="hidden" asp-for="PaymentOption.UserId" />
    <input type="hidden" asp-for="codNote.UserId" value="@Model.PaymentOption.UserId"/>
    <div class="col-md-12">
        <div class="card card-round">
            <div class="card-body">
                <div class="card-head-row card-tools-still-right">
                    <div class="card-title">Payment Details</div>
                </div>
                <div class="card-list py-4">
                    <div class="item-list">
                        <dl class="row">
                            <dt class="col-sm-2">
                                Payment Option
                            </dt>
                            <dd class="col-sm-10">
                                @paymentOption.Name
                            </dd>
                            <dt class="col-sm-2">
                                Detail
                            </dt>
                            <dd class="col-sm-10">
                                @paymentOption.Detail
                            </dd>
                        </dl>
                    </div>
                </div>
                <div class="form-group form-check form-switch">
                    <input id="Switch" class="form-check-input" type="checkbox" role="switch" asp-for="PaymentOption.isEnable" />
                    <label class="form-check-label" asp-for="PaymentOption.isEnable"> </label>
                    <span asp-validation-for="PaymentOption.isEnable" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="card card-round">
            <div class="card-body">
                <div class="card-head-row card-tools-still-right">
                    <div class="card-title">Information to customer</div>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                </div>
                <div class="row py-4">
                    <div class="col-md-12">
                        <div class="form-floating mb-3">
                            <input id="Note" asp-for="codNote.Note" class="form-control" />
                            <label asp-for="codNote.Note" class="form-label">Message</label>
                            <span asp-validation-for="codNote.Note" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="card card-round">
            <div class="card-body">
                <div class="form-group text-center">
                    <input type="submit" value="Save" class="btn btn-primary" />
                    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
                </div>
            </div>
        </div>
    </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_NotificationPartial" />
    }
