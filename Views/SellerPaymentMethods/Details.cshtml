@using E_Commers_Adelia.Common
@model E_Commers_Adelia.Models.SellerPaymentMethod
@inject ApplicationDbContext db
@{
    ViewData["Title"] = "Payment Option";
    var paymentOption = PaymentMethod.All.FirstOrDefault(p => p.Id == Model.PaymentMethodId);
}

<div class="page-header">
    <h3 class="fw-bold mb-3">Detail</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-action="Index">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">@ViewData["Title"]</a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Detail @ViewData["Title"]</a>
        </li>
    </ul>
</div>
<hr />
<div class="card card-round">
    <div class="card-body">

        <dl class="row">
            <dt class="col-sm-2">
                Payment Option
            </dt>
            <dd class="col-sm-10">
                @paymentOption.Name
            </dd>
            <dt class="col-sm-2">
                Detail
            </dt>
            <dd class="col-sm-10">
                @paymentOption.Detail
            </dd>
            <dt class="col-sm-2">
                Status
            </dt>
            <dd class="col-sm-10">
                @if (Model.isEnable)
                {
                    <span class="badge badge-primary">Enable</span>
                }
                else
                {
                    <span class="badge badge-danger">Disable</span>
                }
            </dd>
        </dl>
        <div class="card-footer text-center">
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.Id">Edit</a>
            <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        </div>
    </div>
</div>

