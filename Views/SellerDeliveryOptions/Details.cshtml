@using E_Commers_Adelia.Common
@model E_Commers_Adelia.Models.SellerDeliveryOption

@{
    ViewData["Title"] = "Delivery Options";
    var deLiveryOption = DeliveryOption.All.FirstOrDefault(p => p.Id == Model.DeliveryId);
}
<div class="page-header">
    <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-action="Index">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Detail</a>
        </li>
    </ul>
</div>
<hr />
<div class="col-md-4">
<div class="card card-round">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-6">
                Delivery Option
            </dt>
            <dd class="col-sm-6">
                @deLiveryOption.Name
            </dd>
            <dt class="col-sm-6">
                Detail
            </dt>
            <dd class="col-sm-6">
                @deLiveryOption.Detail
            </dd>
            <dt class="col-sm-6">
                Status
            </dt>
            <dd class="col-sm-6">
                @if (Model.isEnable)
                {
                    <span class="badge badge-primary">Enable</span>
                }
                else
                {
                    <span class="badge badge-danger">Disable</span>
                }
            </dd>
            <dt class="col-sm-6">
                Addtional Charges
            </dt>
            <dd class="col-sm-6">
                <span class="text-success">RM @Model.AdditionalPrice.ToString("0.00")</span>
            </dd>
        </dl>
        <div class="card-footer text-center">
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.Id">Edit</a>
            <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        </div>
    </div>
</div>
</div>