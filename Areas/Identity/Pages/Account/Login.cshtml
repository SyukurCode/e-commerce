@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<form id="account" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-group">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" required>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="form-group d-flex">
        <div class="input-group">
            <input asp-for="Input.Password"
                   class="form-control"
                   autocomplete="current-password"
                   aria-required="true"
                   placeholder="Password"
                   required
                   id="passwordInput"
                   type="password" />
            <div class="input-group-append">
                <span class="input-group-text" onclick="togglePassword()" tabindex="-1">
                    <i id="eyeIcon" class="fa fa-eye-slash"></i>
                </span>
            </div>
        </div>
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary w-100 mb-2 rounded px-3">
            Login
        </button>
        <a id="register" asp-area="Identity" asp-page="/Account/Register" class="btn btn-secondary w-100 rounded px-3">
            Sign Up
        </a>
    </div>

    <div class="form-group d-md-flex">
        <div class="w-50">
            <label asp-for="Input.RememberMe" class="checkbox-wrap checkbox-primary">
                Remember Me
                <input type="checkbox" asp-for="Input.RememberMe" checked>
                <span class="checkmark"></span>
            </label>
        </div>
        <div class="w-50 text-md-right">
            <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
        </div>
    </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
