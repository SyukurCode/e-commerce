@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<hr />

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <input asp-for="Input.Code" type="hidden" />
    <div class="form-group mb-3">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Email address" readonly />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <div class="input-group">
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" id="passwordInput" placeholder="Please enter your password." />
            <div class="input-group-append">
                <span class="input-group-text" onclick="togglePassword()" tabindex="-1">
                    <i id="eyeIcon" class="fa fa-eye-slash"></i>
                </span>
            </div>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group mb-3">
        <div class="input-group">
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" id="passwordInput1" placeholder="Please confirm your password." />
            <div class="input-group-append">
                <span class="input-group-text" onclick="togglePassword1()" tabindex="-1">
                    <i id="eyeIcon1" class="fa fa-eye-slash"></i>
                </span>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
    </div>
    <button type="submit" class="w-100 btn btn-lg btn-primary">Reset</button>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
