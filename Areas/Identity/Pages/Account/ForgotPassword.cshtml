@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<hr />

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-group">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com"/>
        <small asp-validation-for="Input.Email" class="text-danger"></small>
    </div>
    <button type="submit" class="w-100 btn btn-lg btn-primary form-control btn btn-primary rounded submit px-3">Reset Password</button>
</form>
<div class="form-group text-center">
        <a id="forgot-password" asp-page="./Login">Login</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}